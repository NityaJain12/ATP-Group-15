# This file compares the interests of two people using sets to evaluate their compatibility.
# Interest score = number of shared interests / number of total unique interests
#
# Example
# {hiking, chess, movies} and {hiking, chess, ccoking, music}
# shared = {hiking, chess}
# combined = {hiking, chess, movies, cooking, music}
# interest_score = 2/5 = 0.4
#
#Thus, this gives us an interest compatibility score. 
# This number is always between 0 (nothing in common) and 1 (same exact interests).

def clean_interests(interest_list):
""" Make the list of interests entered by the user a set of tidy words. 
"Music" and "music" become the same word, blank entries are ignored, and repeaded entries are removed automatically as sets don't have repeated elements."""
cleaned = set()
for interest in interest_list:
word = interest.strip().lower()
if word != "":
cleaned.add(word)
return cleaned

